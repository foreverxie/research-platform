# =============================================================================
# ScholarAI AI Service 配置示例
# 复制为 .env 后按需修改；环境变量优先级高于 .env
# =============================================================================

# ------------------------------------------------------------------ 服务基础
APP_PORT=8000
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Java 后端只传相对路径（如 documents/1/original.pdf），这里配置存储根目录
STORAGE_ROOT=../research-platform/storage

# 非空时所有 /internal/v1/* 接口都要求请求头 X-Internal-Token 完全一致；
# 留空则跳过校验（与后端 research.ai.internal-token 默认值保持一致）
INTERNAL_TOKEN=

# 调用模型接口的超时（秒）
REQUEST_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------ MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=research_knowledge_db
MYSQL_CONNECT_TIMEOUT=5

# --------------------------------------------------------------- Embedding
# auto：有 DASHSCOPE_API_KEY 时用 dashscope；否则有 OPENAI_API_KEY 时用 openai；
#       都没有则 local
# 也可显式指定 local / dashscope / openai
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-v3
# DashScope text-embedding-v3 默认 1024 维；本地哈希向量也使用该维度
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

DASHSCOPE_API_KEY=
OPENAI_API_KEY=
# OpenAI 兼容地址需要包含版本段，例如 https://api.openai.com/v1
OPENAI_BASE_URL=

# --------------------------------------------------------------------- LLM
# auto：有 DASHSCOPE_API_KEY 时用 qwen；有 OPENAI_API_KEY 时用 openai；否则 local
LLM_PROVIDER=auto
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000

# -------------------------------------------------------------- 向量存储
# milvus：启动时连接 MILVUS_URI，失败自动回退 local
# local：直接使用 numpy + JSON（data/vectors）
VECTOR_STORE=milvus
MILVUS_URI=http://localhost:19531
MILVUS_COLLECTION=paper_chunks
MILVUS_TIMEOUT_SECONDS=5

# 本地兜底向量库目录（相对 ai-service 根目录）
LOCAL_VECTOR_DIR=./data/vectors

# -------------------------------------------------------------------- 解析
# auto：检测到 MINERU_TOKEN 优先云端 MinerU；否则本地 mineru 命令；最后 PyMuPDF
# mineru / pymupdf：强制指定
PARSER=auto
MINERU_CMD=mineru
MINERU_TIMEOUT_SECONDS=600

# MinerU 云端 API（推荐，适合双栏/表格论文）
# auto：有 MINERU_TOKEN 时优先云端；cloud：只用云端；local：只用本地 CLI；off：关闭
MINERU_PROVIDER=auto
MINERU_TOKEN=
# pipeline 通用；vlm 对复杂版面更强但更慢/更贵
MINERU_MODEL=pipeline
MINERU_OCR=false
MINERU_CLOUD_BASE_URL=https://mineru.net/api/v4
MINERU_CLOUD_TIMEOUT_SECONDS=600

# -------------------------------------------------------------------- 其他
ANALYZE_MAX_CHARS=12000
RAG_MAX_CONTEXT_CHARS=8000

# 可选：私有化 DashScope 兼容网关
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
